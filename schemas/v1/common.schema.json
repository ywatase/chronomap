{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronomap.example/schemas/v1/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:(?:dataset|entity|version|source|evidence|hypothesis):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-x(?:-[A-Za-z0-9]{1,8})+)?|x(?:-[A-Za-z0-9]{1,8})+|i-(?:ami|bnn|default|enochian|hak|klingon|lux|mingo|navajo|pwn|tao|tay|tsu)|(?:art-lojban|cel-gaulish|en-GB-oed|no-bok|no-nyn|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))$"
    },
    "textMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/languageTag" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "rights": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["public-domain", "open-license", "permission", "restricted", "unknown"]
        },
        "attribution": { "type": "string", "minLength": 1 },
        "terms": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "temporalBoundary": {
      "type": "object",
      "required": ["earliestYear", "latestYear", "precision", "qualifier"],
      "properties": {
        "earliestYear": { "type": ["integer", "null"] },
        "latestYear": { "type": ["integer", "null"] },
        "precision": { "enum": ["year", "decade", "century", "period", "unknown"] },
        "qualifier": { "enum": ["exact", "circa", "before", "after", "unknown"] }
      },
      "anyOf": [
        { "properties": { "earliestYear": { "type": "integer" } } },
        { "properties": { "latestYear": { "type": "integer" } } }
      ],
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "anyOf": [{ "$ref": "#/$defs/temporalBoundary" }, { "type": "null" }] },
        "end": { "anyOf": [{ "$ref": "#/$defs/temporalBoundary" }, { "type": "null" }] }
      },
      "not": {
        "properties": { "start": { "type": "null" }, "end": { "type": "null" } },
        "required": ["start", "end"]
      },
      "additionalProperties": false
    },
    "uncertaintyAssessment": {
      "type": "object",
      "required": ["assessment", "note", "evidenceIds"],
      "properties": {
        "assessment": {
          "enum": ["well-supported", "approximate", "disputed", "unknown", "not-applicable"]
        },
        "note": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:evidence:[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "assessment": { "enum": ["well-supported", "approximate", "disputed"] } } },
          "then": { "properties": { "evidenceIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "assessment": { "enum": ["approximate", "disputed", "unknown", "not-applicable"] } } },
          "then": { "properties": { "note": { "minLength": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["temporal", "location", "geometry", "identity"],
      "properties": {
        "temporal": { "$ref": "#/$defs/uncertaintyAssessment" },
        "location": { "$ref": "#/$defs/uncertaintyAssessment" },
        "geometry": { "$ref": "#/$defs/uncertaintyAssessment" },
        "identity": { "$ref": "#/$defs/uncertaintyAssessment" }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/$defs/position" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "MultiPoint" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "LineString" }, "coordinates": { "type": "array", "items": { "$ref": "#/$defs/position" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "MultiLineString" }, "coordinates": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/position" } } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "Polygon" }, "coordinates": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/position" } } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": { "type": { "const": "MultiPolygon" }, "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/position" } } } } },
          "additionalProperties": false
        }
      ]
    }
  }
}
