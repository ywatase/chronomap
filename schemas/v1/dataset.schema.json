{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronomap.example/schemas/v1/dataset.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "description", "defaultLanguage", "bbox", "temporalExtent", "rights", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/datasetId" },
    "title": { "$ref": "common.schema.json#/$defs/textMap" },
    "description": { "$ref": "common.schema.json#/$defs/textMap" },
    "defaultLanguage": { "$ref": "common.schema.json#/$defs/languageTag" },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "temporalExtent": { "$ref": "common.schema.json#/$defs/temporal" },
    "rights": { "$ref": "common.schema.json#/$defs/rights" },
    "display": {
      "type": "object",
      "properties": { "minZoom": { "type": "integer", "minimum": 0, "maximum": 12 } },
      "additionalProperties": false
    },
    "historicalMapAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/historicalMapAsset" }
    },
    "files": {
      "type": "object",
      "required": ["entities", "sources", "evidence", "featureVersions"],
      "properties": {
        "entities": { "const": "entities.json" },
        "sources": { "const": "sources.json" },
        "evidence": { "const": "evidence.json" },
        "featureVersions": { "const": "feature-versions.geojson" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "historicalMapAsset": {
      "type": "object",
      "required": ["id", "title", "description", "bbox", "date", "accessedDate", "georeference", "sourceUrl", "attribution", "rights", "minZoom", "maxZoom"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "$ref": "common.schema.json#/$defs/textMap" },
        "description": { "$ref": "common.schema.json#/$defs/textMap" },
        "tileTemplate": { "type": "string", "pattern": "^https://[^\\s]+\\{z\\}[^\\s]+\\{x\\}[^\\s]+\\{y\\}[^\\s]*$" },
        "imageUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "date": { "type": "string", "minLength": 1 },
        "accessedDate": { "type": "string", "format": "date" },
        "georeference": {
          "type": "object",
          "required": ["method", "error"],
          "properties": { "method": { "type": "string", "minLength": 1 }, "error": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "attribution": { "type": "string", "minLength": 1 },
        "rights": { "allOf": [{ "$ref": "common.schema.json#/$defs/rights" }, { "not": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] } }] },
        "minZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
        "maxZoom": { "type": "integer", "minimum": 0, "maximum": 24 }
      },
      "oneOf": [
        { "required": ["tileTemplate"], "not": { "required": ["imageUrl"] } },
        { "required": ["imageUrl"], "not": { "required": ["tileTemplate"] } }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
