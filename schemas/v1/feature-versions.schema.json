{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronomap.example/schemas/v1/feature-versions.schema.json",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:version:[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "geometry": { "$ref": "common.schema.json#/$defs/geometry" },
          "properties": {
            "type": "object",
            "required": ["entityId", "labels", "description", "temporal", "uncertainty", "evidenceIds", "rights"],
            "properties": {
              "entityId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:entity:[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "labels": { "$ref": "common.schema.json#/$defs/textMap" },
              "description": { "$ref": "common.schema.json#/$defs/textMap" },
              "temporal": { "$ref": "common.schema.json#/$defs/temporal" },
              "uncertainty": { "$ref": "common.schema.json#/$defs/uncertainty" },
              "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:evidence:[a-z0-9]+(?:-[a-z0-9]+)*$" } },
              "publicationStatus": { "enum": ["public", "private"], "default": "private" },
              "rights": { "$ref": "common.schema.json#/$defs/rights" },
              "hypothesisGroupId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:hypothesis:[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "hypothesisLabel": { "$ref": "common.schema.json#/$defs/textMap" }
            },
            "allOf": [
              {
                "if": { "required": ["hypothesisGroupId"] },
                "then": { "required": ["hypothesisLabel"] }
              },
              {
                "if": { "required": ["hypothesisLabel"] },
                "then": { "required": ["hypothesisGroupId"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
